/* Тестова програма 1: Лінійний алгоритм
/* Варіант: Войтович Олександр Вікторович
/* Мова: V03

Program LN;
Var Int16 A, B, X, Y;
Begin
    /* Введення двох чисел A і B
    Get A;
    Get B;

    /* Виведення результатів арифметичних операцій
    Put A + B;
    Put A - B;
    Put A Mul B;
    Put A Div B;
    Put A Mod B;

    /* Обчислення значення виразу X = (A - B) * 10 + (A + B) / 10
    X ::= (A - B) Mul 10 + (A + B) Div 10;

    /* Обчислення значення виразу Y = X + X % 10
    Y ::= X + X Mod 10;

    /* Виведення X і Y
    Put X;
    Put Y
End
