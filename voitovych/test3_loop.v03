/* Тестова програма 3: Циклічний алгоритм
/* Варіант: Войтович Олександр Вікторович
/* Мова: V03

Program LP;
Var Int16 A, B, I, J, X;
Begin
    /* Введення двох чисел A і B (A < B)
    Get A;
    Get B;

    /* Виведення квадратів чисел від A до B (простий цикл)
    For I ::= A To B
        Put I Mul I
    Next I;

    /* Обчислення X = A * B за алгоритмом (вкладений цикл)
    /* X = 0
    /* Цикл від 1 до A
    /*     Цикл від 1 до B
    /*         X = X + 1
    X ::= 0;
    For I ::= 1 To A
        For J ::= 1 To B
            X ::= X + 1
        Next J
    Next I;

    /* Виведення результату X
    Put X
End
