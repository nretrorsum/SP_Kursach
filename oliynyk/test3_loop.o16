/* CyclicAlgorithm - Test 3: Loop algorithm with while cycles
startprogram
variable _A, _B, _I, _J, _X, _SQR;
startblok
    /* Input two numbers A and B
    get(_A);
    get(_B);

    /* Simple loop: output squares from A to B
    _I :: _A;
    while _I less _B + 1 startblok
        _SQR :: _I * _I;
        put(_SQR);
        _I :: _I + 1;
    endblok

    /* Nested loop: calculate product
    _X :: 0;
    _I :: 1;
    while _I less _A + 1 startblok
        _J :: 1;
        while _J less _B + 1 startblok
            _X :: _X + 1;
            _J :: _J + 1;
        endblok
        _I :: _I + 1;
    endblok

    /* Output result
    put(_X);
endblok
