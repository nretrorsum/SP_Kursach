/* LinearAlgorithm - Test 1: Linear algorithm with arithmetic operations
startprogram
variable _X, _Y, _Z, _R, _T;
startblok
    /* 1. Input two numbers
    get(_X);
    get(_Y);

    /* 2. Output arithmetic operations: addition
    _Z :: _X + _Y;
    put(_Z);

    /* subtraction
    _Z :: _X - _Y;
    put(_Z);

    /* multiplication
    _Z :: _X * _Y;
    put(_Z);

    /* division
    _Z :: _X / _Y;
    put(_Z);

    /* modulo
    _Z :: _X % _Y;
    put(_Z);

    /* 3. Calculate X = (A - B) * 10 + (A + B) / 10
    _R :: (_X - _Y) * 10 + (_X + _Y) / 10;

    /* 4. Calculate Y = X + X % 10
    _T :: _R + _R % 10;

    /* 5. Output X and Y
    put(_R);
    put(_T);
endblok
