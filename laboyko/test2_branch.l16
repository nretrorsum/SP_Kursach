@@ Test 2: Branching algorithm - If-Then Goto (Basic style)
#Program BRANCH;
Start Variable A, B, MAX

@@ Input values
Get(A);
Get(B);

@@ Find maximum using If-Then Goto
If A !< B Then Goto AMAX;
@@ B is max or equal
MAX >> B;
Goto PRINT;

AMAX:
MAX >> A;

PRINT:
Put(MAX);

@@ Check equality
If A <> B Then Goto NOTEQUAL;
Put(1);
Goto END;

NOTEQUAL:
Put(0);

END:

Stop
