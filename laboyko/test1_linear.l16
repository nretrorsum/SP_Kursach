@@ Test 1: Linear algorithm - arithmetic operations
#Program LINEAR;
Start Variable X, Y, Z, R

@@ Initialize variables
X >> 10;
Y >> 5;

@@ Addition
Z >> X + Y;
Put(Z);

@@ Subtraction
Z >> X - Y;
Put(Z);

@@ Multiplication
Z >> X Mul Y;
Put(Z);

@@ Division
Z >> X Div Y;
Put(Z);

@@ Modulo
Z >> X Mod Y;
Put(Z);

@@ Complex expression
R >> (X + Y) Mul 2 - Y Div Y;
Put(R);

Stop
