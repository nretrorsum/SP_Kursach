%% Тестова програма 1: Лінійний алгоритм %%
%% Автор: Запливаний Данііл Валерійович %%
%% Варіант: 07 %%

program LIN;
var int16_t A, B, X, Y, T1, T2, T3, T4, T5

start
    %% 1. Ввести два числа А і В %%
    get A;
    get B;

    %% 2. Вивести результати арифметичних операцій %%
    T1 <- A + B;
    put T1;

    T2 <- A - B;
    put T2;

    T3 <- A * B;
    put T3;

    T4 <- A / B;
    put T4;

    T5 <- A % B;
    put T5;

    %% 3. Обрахувати значення виразів %%
    %% X = (A - B) * 10 + (A + B) / 10 %%
    X <- (A - B) * 10 + (A + B) / 10;

    %% Y = X + X % 10 %%
    Y <- X + X % 10;

    %% 4. Вивести значення X і Y %%
    put X;
    put Y;
finish
